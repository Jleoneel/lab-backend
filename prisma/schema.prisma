// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  ANALYST
}

model User {
  id           String   @id @default(uuid())
  fullName     String
  email        String   @unique
  passwordHash String
  role         UserRole @default(ADMIN)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  analysesAssigned  SampleService[]
  mensajesEnviados  Mensaje[] @relation("MensajesEnviados")  
  mensajesRecibidos Mensaje[] @relation("MensajesRecibidos")
}

model Client {
  id        String   @id @default(uuid())
  name      String
  address   String?
  city      String?
  phone     String?
  email     String?
  acuerdoFirmado  Boolean   @default(false)
  fechaAcuerdo    DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quotes   Quote[]
  requests Request[]
  acuerdos AcuerdoConfidencialidad[]

  @@index([name])
}

model Service {
  id            String   @id @default(uuid())
  code          String   @unique
  name          String
  priceExternal Decimal
  priceStudent  Decimal
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  quoteItems  QuoteItem[]
  sampleLinks SampleService[]

  @@index([name])
}

enum PriceList {
  EXTERNO
  ESTUDIANTE
}

enum QuoteStatus {
  DRAFT
  SENT
  APPROVED
  CANCELLED
  CONVERTED
}

model Quote {
  id          Int    @id @default(autoincrement())
  quoteNumber String @unique

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  priceList  PriceList
  ivaPercent Decimal
  subtotal   Decimal
  ivaAmount  Decimal
  total      Decimal

  validUntil DateTime?
  status     QuoteStatus @default(DRAFT)

  items QuoteItem[]
  request Request?
  acuerdos AcuerdoConfidencialidad[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([createdAt])
}

model QuoteItem {
  id      String @id @default(uuid())
  quoteId Int
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id])

  quantity         Int
  unitPriceApplied Decimal
  lineSubtotal     Decimal

  createdAt DateTime @default(now())

  @@index([quoteId])
  @@index([serviceId])
}

enum RequestStatus {
  OPEN
  IN_PROGRESS
  READY_REPORT
  DONE
  CANCELLED
}

enum SampleStatus {
  EN_COLA
  EN_PROCESO
  LISTO_PARA_INFORME
  TERMINADO
}

model Request {
  id            Int    @id @default(autoincrement())
  requestNumber String @unique

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  quoteId Int?  @unique
  quote   Quote? @relation(fields: [quoteId], references: [id])

  status RequestStatus @default(OPEN)

  samples Sample[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([quoteId])
  @@index([createdAt])
}

model Sample {
  id        Int     @id @default(autoincrement())
  requestId Int
  request   Request @relation(fields: [requestId], references: [id], onDelete: Cascade)

  sampleCode        String   @unique
  sampleName        String?
  objetivoAnalisis  String? 
  cantidadRecibida  String? 
  receivedAt        DateTime @default(now())

  status SampleStatus @default(EN_COLA)

  history SampleStatusHistory[]
  services SampleService[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([requestId])
  @@index([status])
  @@index([receivedAt])
}

model SampleStatusHistory {
  id       String @id @default(uuid())
  sampleId Int
  sample   Sample @relation(fields: [sampleId], references: [id], onDelete: Cascade)

  fromStatus SampleStatus?
  toStatus   SampleStatus

  changedBy String
  changedAt DateTime @default(now())
  note      String?

  @@index([sampleId])
  @@index([changedAt])
}

enum SampleServiceStatus {
  PENDING
  RUNNING
  DONE
}

model SampleService {
  id String @id @default(uuid())

  sampleId Int
  sample   Sample @relation(fields: [sampleId], references: [id], onDelete: Cascade)

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id])

  repeticion Int @default(1)

  status SampleServiceStatus @default(PENDING)

  assignedTo String?
  assignedToId  String?
  assignedUser User? @relation(fields: [assignedToId], references: [id])

  startedAt  DateTime?
  finishedAt DateTime?

  createdAt DateTime @default(now())
  result    Result?
  movimientosReactivos MovimientoReactivo[]


  @@unique([sampleId, serviceId, repeticion])
  @@index([sampleId])
  @@index([serviceId])
  @@index([status])
  @@index([assignedToId])
}

model Result {
  id              String @id @default(uuid())
  sampleServiceId String @unique
  sampleService   SampleService @relation(fields: [sampleServiceId], references: [id], onDelete: Cascade)

  resultText    String?
  resultNumber  Decimal?
  unit          String?
  isFinal       Boolean  @default(false)
  observaciones String?

  recordedBy String
  recordedAt DateTime @default(now())

  archivos ResultFile[]
}

model ResultFile {
  id        String @id @default(uuid())
  resultId  String
  result    Result @relation(fields: [resultId], references: [id], onDelete: Cascade)

  filename     String  // nombre original
  path         String  // ruta en disco
  createdAt    DateTime @default(now())
}

model ConfiguracionSistema {
  id        String   @id @default(uuid())
  clave     String   @unique
  valor     String
  updatedAt DateTime @updatedAt
}

model CategoriaReactivo {
  id        String     @id @default(uuid())
  nombre    String     @unique
  activo    Boolean    @default(true)
  createdAt DateTime   @default(now())
  reactivos Reactivo[]
}

enum UnidadReactivo {
  LITROS
  KILOGRAMOS
}

enum TipoMovimiento {
  INGRESO
  CONSUMO
}

model Reactivo {
  id          String            @id @default(uuid())
  codigo      String            @unique
  nombre      String
  categoriaId String
  unidad      UnidadReactivo
  stockActual Decimal           @default(0)
  stockMinimo Decimal           @default(0)
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  categoria   CategoriaReactivo @relation(fields: [categoriaId], references: [id])
  movimientos MovimientoReactivo[]

  @@index([nombre])
  @@index([categoriaId])
}

model MovimientoReactivo {
  id              String       @id @default(uuid())
  reactivoId      String
  reactivo        Reactivo     @relation(fields: [reactivoId], references: [id])

  tipo            TipoMovimiento
  razonId         String?          
  razon           RazonConsumo? @relation(fields: [razonId], references: [id])
  cantidad        Decimal
  sampleServiceId String?
  sampleService   SampleService? @relation(fields: [sampleServiceId], references: [id])
  registradoPor   String
  observaciones   String?
  createdAt       DateTime     @default(now())

  @@index([reactivoId])
  @@index([createdAt])
  @@index([tipo])
}

model RazonConsumo {
  id        String   @id @default(uuid())
  nombre    String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movimientos MovimientoReactivo[]
}

enum EstadoEquipo {
  ACTIVO
  EN_MANTENIMIENTO
  FUERA_DE_SERVICIO
  DADO_DE_BAJA
}

model Equipo {
  id                   String      @id @default(uuid())
  nombre               String
  modelo               String?
  marca                String?
  serie                String?     @unique
  codigoInventario     String      @unique
  ubicacion            String?
  fotoUrl String?
  fechaAdquisicion     DateTime?
  fechaMantenimiento   DateTime?
  fechaCalibracion     DateTime?
  estado               EstadoEquipo @default(ACTIVO)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
}

model CategoriaDocumento {
  id        String   @id @default(uuid())
  nombre    String
  orden     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enlaces EnlaceDocumento[]
}

model EnlaceDocumento {
  id          String   @id @default(uuid())
  titulo      String
  url         String
  descripcion String?
  categoriaId String
  categoria   CategoriaDocumento @relation(fields: [categoriaId], references: [id], onDelete: Cascade)
  orden       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Mensaje {
  id          String   @id @default(uuid())
  fromId      String
  from        User     @relation("MensajesEnviados", fields: [fromId], references: [id])
  toId        String
  to          User     @relation("MensajesRecibidos", fields: [toId], references: [id])
  contenido   String
  leido       Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([toId])
  @@index([fromId])
  @@index([leido])
}

model AcuerdoConfidencialidad {
  id        String   @id @default(uuid())
  codigo    String   @unique
  version   String   @default("1.0")
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id])
  quoteId   Int
  quote     Quote    @relation(fields: [quoteId], references: [id])
  creadoPor String
  archivoUrl String?
  createdAt DateTime @default(now())
}