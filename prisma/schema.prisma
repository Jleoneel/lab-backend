// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  ANALYST
}

model User {
  id           String   @id @default(uuid())
  fullName     String
  email        String   @unique
  passwordHash String
  role         UserRole @default(ADMIN)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Client {
  id        String   @id @default(uuid())
  name      String
  address   String?
  city      String?
  phone     String?
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quotes   Quote[]
  requests Request[]

  @@index([name])
}

model Service {
  id            String   @id @default(uuid())
  code          String   @unique
  name          String
  priceExternal Decimal
  priceStudent  Decimal
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  quoteItems  QuoteItem[]
  sampleLinks SampleService[]

  @@index([name])
}

enum PriceList {
  EXTERNO
  ESTUDIANTE
}

enum QuoteStatus {
  DRAFT
  SENT
  APPROVED
  CANCELLED
  CONVERTED
}

model Quote {
  id          Int    @id @default(autoincrement())
  quoteNumber String @unique

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  priceList  PriceList
  ivaPercent Decimal
  subtotal   Decimal
  ivaAmount  Decimal
  total      Decimal

  validUntil DateTime?
  status     QuoteStatus @default(DRAFT)

  items QuoteItem[]
  request Request?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([createdAt])
}

model QuoteItem {
  id      String @id @default(uuid())
  quoteId Int
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id])

  quantity         Int
  unitPriceApplied Decimal
  lineSubtotal     Decimal

  createdAt DateTime @default(now())

  @@index([quoteId])
  @@index([serviceId])
}

enum RequestStatus {
  OPEN
  IN_PROGRESS
  READY_REPORT
  DONE
  CANCELLED
}

enum SampleStatus {
  EN_COLA
  EN_PROCESO
  LISTO_PARA_INFORME
  TERMINADO
}

model Request {
  id            Int    @id @default(autoincrement())
  requestNumber String @unique

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  quoteId Int?  @unique
  quote   Quote? @relation(fields: [quoteId], references: [id])

  status RequestStatus @default(OPEN)

  samples Sample[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([quoteId])
  @@index([createdAt])
}

model Sample {
  id        Int     @id @default(autoincrement())
  requestId Int
  request   Request @relation(fields: [requestId], references: [id], onDelete: Cascade)

  sampleCode        String   @unique
  sampleName        String?
  objetivoAnalisis  String? 
  cantidadRecibida  String? 
  receivedAt        DateTime @default(now())

  status SampleStatus @default(EN_COLA)

  history SampleStatusHistory[]
  services SampleService[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([requestId])
  @@index([status])
  @@index([receivedAt])
}

model SampleStatusHistory {
  id       String @id @default(uuid())
  sampleId Int
  sample   Sample @relation(fields: [sampleId], references: [id], onDelete: Cascade)

  fromStatus SampleStatus?
  toStatus   SampleStatus

  changedBy String
  changedAt DateTime @default(now())
  note      String?

  @@index([sampleId])
  @@index([changedAt])
}

enum SampleServiceStatus {
  PENDING
  RUNNING
  DONE
}

model SampleService {
  id String @id @default(uuid())

  sampleId Int
  sample   Sample @relation(fields: [sampleId], references: [id], onDelete: Cascade)

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id])

  repeticion Int @default(1)

  status SampleServiceStatus @default(PENDING)

  assignedTo String?
  startedAt  DateTime?
  finishedAt DateTime?

  createdAt DateTime @default(now())
  result    Result?

  @@unique([sampleId, serviceId, repeticion])
  @@index([sampleId])
  @@index([serviceId])
  @@index([status])
}

model Result {
  id              String @id @default(uuid())
  sampleServiceId String @unique
  sampleService   SampleService @relation(fields: [sampleServiceId], references: [id], onDelete: Cascade)

  resultText   String?
  resultNumber Decimal?
  unit         String?
  isFinal      Boolean  @default(false)

  recordedBy String
  recordedAt DateTime @default(now())
}